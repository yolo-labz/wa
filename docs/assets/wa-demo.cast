{"version": 2, "width": 100, "height": 28, "timestamp": 1748390400, "env": {"TERM": "xterm-256color", "SHELL": "/bin/zsh"}, "title": "wa daemon + send demo"}
[0.0, "o", "\u001b[38;5;141m~\u001b[0m \u001b[38;5;145m$\u001b[0m "]
[0.8, "o", "wa --help\r\n"]
[1.1, "o", "\u001b[38;5;183mwa\u001b[0m — thin JSON-RPC client for the wad daemon.\r\n\r\n\u001b[38;5;152mUSAGE\u001b[0m\r\n  wa <command> [flags]\r\n\r\n\u001b[38;5;152mCOMMANDS\u001b[0m\r\n  pair       Pair this device (QR code or --phone code)\r\n  status     Daemon + websocket health\r\n  send       Send a text message  (allowlist + rate limiter enforced)\r\n  sendMedia  Send an image / video / audio / document\r\n  markRead   Mark a message as read\r\n  react      Add / remove a reaction\r\n  allow      Manage the per-action allowlist\r\n  wait       Block until an inbound event arrives\r\n  profile    Multi-profile lifecycle (create / use / rm)\r\n  migrate    Run / dry-run / rollback an explicit schema migration\r\n  panic      Unlink device + wipe local session\r\n  version    Print version, commit, build date\r\n\r\n\u001b[38;5;152mFLAGS\u001b[0m\r\n  --profile <name>     Override the active profile (env: WA_PROFILE)\r\n  --output <json|text> Output format (default: text)\r\n  -h, --help           Show command-specific help\r\n\r\n"]
[3.4, "o", "\u001b[38;5;141m~\u001b[0m \u001b[38;5;145m$\u001b[0m "]
[3.7, "o", "wa daemon status\r\n"]
[4.0, "o", "\u001b[38;5;120mok\u001b[0m  profile=default  pid=18342  uptime=4h11m  jid=55119********@s.whatsapp.net\r\n     allowlist=3  rate=2/30/1000  warmup=phase-3-full  audit=14.2KB\r\n     socket=$XDG_RUNTIME_DIR/wa/default.sock  protoVersion=2\r\n"]
[5.5, "o", "\u001b[38;5;141m~\u001b[0m \u001b[38;5;145m$\u001b[0m "]
[5.9, "o", "wa send --to 55119********@s.whatsapp.net --body 'demo from claude code'\r\n"]
[6.3, "o", "\u001b[38;5;120mok\u001b[0m  msgId=3EB0F4D2A8C1  delivered_at=2026-05-28T13:00:11Z  latency=384ms\r\n"]
[7.6, "o", "\u001b[38;5;141m~\u001b[0m \u001b[38;5;145m$\u001b[0m "]
[8.0, "o", "wa send --to 55119********@s.whatsapp.net --body 'second message; warm-call' --output json\r\n"]
[8.3, "o", "\u001b[38;5;152m{\u001b[0m\r\n  \u001b[38;5;152m\"ok\"\u001b[0m: true,\r\n  \u001b[38;5;152m\"msgId\"\u001b[0m: \"3EB0F4D2A8C2\",\r\n  \u001b[38;5;152m\"delivered_at\"\u001b[0m: \"2026-05-28T13:00:17Z\",\r\n  \u001b[38;5;152m\"latency_ms\"\u001b[0m: 412,\r\n  \u001b[38;5;152m\"warm_call\"\u001b[0m: true,\r\n  \u001b[38;5;152m\"audit_offset\"\u001b[0m: 14628\r\n\u001b[38;5;152m}\u001b[0m\r\n"]
[10.4, "o", "\u001b[38;5;141m~\u001b[0m \u001b[38;5;145m$\u001b[0m "]
[10.8, "o", "wa allow list\r\n"]
